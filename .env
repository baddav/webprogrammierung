# ----------------------------
# Server-Konfiguration
# ----------------------------
# Port, auf dem die Express-API läuft
PORT=3000

# ----------------------------
# Datenbank
# ----------------------------
# Hostname des Datenbankcontainers
DB_HOST=db

# Benutzername und Passwort für die Anwendung
DB_USER=admin
DB_PASSWORD=1234

# Name der Datenbank
DB_NAME=pokedex

# Interner Port im Container
DB_PORT=3306

# Root-Passwort für MySQL
MYSQL_ROOT_PASSWORD=root
